# Optional AI reader uses an already signed-in Claude CLI. No provider key is bundled.
SHIFTPATCH_AI=on
# Set these only after creating your own local Switch agent and room.
SHIFTPATCH_SWITCH_URL=http://127.0.0.1:18000
SHIFTPATCH_SWITCH_AGENT_ID=
SHIFTPATCH_SWITCH_API_KEY=
SHIFTPATCH_SWITCH_ROOM_ID=
SHIFTPATCH_SWITCH_AGENT_NAME=shiftpatch
